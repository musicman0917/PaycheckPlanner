</div>

<script>
  const PAY_PER_YEAR = { weekly: 52, biweekly: 26, semimonthly: 24, monthly: 12 };
  const CAT_COLORS = [
    '#c84b31','#d4a843','#2d6a4f','#4a7fb5','#8b5cf6',
    '#e07b54','#3a9e87','#b5507a','#6b7c3f','#c0733a'
  ];

  let categories = [];
  let catId = 0, vendorId = 0;

  function colorFor(idx) { return CAT_COLORS[idx % CAT_COLORS.length]; }

  function addCategory(name='', collapsed=false) {
    const id = catId++;
    categories.push({ id, name, color: colorFor(categories.length), collapsed, vendors: [] });
    renderCategories();
    calculate();
    if (!name) {
      setTimeout(() => {
        const el = document.querySelector(`[data-catname="${id}"]`);
        if (el) el.focus();
      }, 60);
    }
  }

  function removeCategory(id) {
    if (!confirm('Remove this category and all its vendors?')) return;
    categories = categories.filter(c => c.id !== id);
    renderCategories();
    calculate();
  }

  function updateCatName(id, val) {
    const c = categories.find(c => c.id === id);
    if (c) { c.name = val; calculate(); }
  }

  function toggleCat(id) {
    const c = categories.find(c => c.id === id);
    if (!c) return;
    c.collapsed = !c.collapsed;
    document.querySelector(`[data-catbody="${id}"]`)?.classList.toggle('hidden', c.collapsed);
    document.querySelector(`[data-cattog="${id}"]`)?.classList.toggle('collapsed', c.collapsed);
  }

  function addVendor(catId, vendor='', description='', amount='', freq='monthly') {
    const c = categories.find(c => c.id === catId);
    if (!c) return;
    const id = vendorId++;
    c.vendors.push({ id, vendor, description, amount, freq });
    renderCategoryVendors(catId);
    calculate();
  }

  function removeVendor(catId, vid) {
    const c = categories.find(c => c.id === catId);
    if (!c) return;
    c.vendors = c.vendors.filter(v => v.id !== vid);
    renderCategoryVendors(catId);
    calculate();
  }

  function updateVendor(catId, vid, field, value) {
    const c = categories.find(c => c.id === catId);
    const v = c?.vendors.find(v => v.id === vid);
    if (v) { v[field] = value; calculate(); }
  }

  function billToPerPaycheck(amount, billFreq, payFreq) {
    const monthly = { weekly: amount*4.3333, biweekly: amount*2.1667, semimonthly: amount*2,
      monthly: amount, quarterly: amount/3, yearly: amount/12 }[billFreq] || amount;
    return (monthly * 12) / PAY_PER_YEAR[payFreq];
  }

  function fmt(n) {
    return '$' + Math.abs(n).toLocaleString('en-US', { minimumFractionDigits:2, maximumFractionDigits:2 });
  }
  function esc(s) {
    return String(s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function renderCategoryVendors(catId) {
    const c = categories.find(c => c.id === catId);
    if (!c) return;
    const container = document.querySelector(`[data-vendorlist="${catId}"]`);
    if (!container) return;
    container.innerHTML = '';

    if (c.vendors.length > 0) {
      const hdr = document.createElement('div');
      hdr.className = 'vendor-col-headers';
      hdr.innerHTML = `<span>Vendor</span><span class="desc-header">Description / Note</span><span>Amount ($)</span><span>Frequency</span><span></span>`;
      container.appendChild(hdr);
    }

    c.vendors.forEach(v => {
      const row = document.createElement('div');
      row.className = 'vendor-row';
      row.innerHTML = `
        <input type="text" placeholder="e.g. Comcast, Landlord" value="${esc(v.vendor)}"
          oninput="updateVendor(${catId},${v.id},'vendor',this.value)">
        <input type="text" class="desc-col" placeholder="optional note…" value="${esc(v.description)}"
          oninput="updateVendor(${catId},${v.id},'description',this.value)">
        <input type="number" placeholder="0.00" value="${v.amount}" min="0" step="0.01"
          oninput="updateVendor(${catId},${v.id},'amount',this.value)">
        <select onchange="updateVendor(${catId},${v.id},'freq',this.value)">
          <option value="weekly"      ${v.freq==='weekly'?'selected':''}>Weekly</option>
          <option value="biweekly"    ${v.freq==='biweekly'?'selected':''}>Bi-Weekly</option>
          <option value="semimonthly" ${v.freq==='semimonthly'?'selected':''}>2x / Month</option>
          <option value="monthly"     ${v.freq==='monthly'?'selected':''}>Monthly</option>
          <option value="quarterly"   ${v.freq==='quarterly'?'selected':''}>Quarterly</option>
          <option value="yearly"      ${v.freq==='yearly'?'selected':''}>Yearly</option>
        </select>
        <button class="delete-btn" onclick="removeVendor(${catId},${v.id})">×</button>
      `;
      container.appendChild(row);
    });
  }

  function renderCategories() {
    const list = document.getElementById('categoryList');
    list.innerHTML = '';
    categories.forEach(c => {
      const block = document.createElement('div');
      block.className = 'category-block';
      block.innerHTML = `
        <div class="cat-header" onclick="toggleCat(${c.id})">
          <div class="cat-dot" style="background:${c.color};"></div>
          <input class="cat-name-input" data-catname="${c.id}" type="text"
            placeholder="Category name…" value="${esc(c.name)}"
            onclick="event.stopPropagation()"
            oninput="updateCatName(${c.id},this.value)">
          <span class="cat-total" data-cattotal="${c.id}"></span>
          <span class="cat-toggle ${c.collapsed?'collapsed':''}" data-cattog="${c.id}">▾</span>
          <button class="cat-delete-btn" onclick="event.stopPropagation();removeCategory(${c.id})">×</button>
        </div>
        <div class="cat-body ${c.collapsed?'hidden':''}" data-catbody="${c.id}">
          <div data-vendorlist="${c.id}"></div>
          <button class="add-vendor-btn" onclick="addVendor(${c.id})">+ Add Vendor</button>
        </div>
      `;
      list.appendChild(block);
      renderCategoryVendors(c.id);
    });
  }

  // ── One-off payments ──
  let oneoffs = [];
  let oneoffId = 0;

  function nextPaycheckDateRange() {
    // Returns {start, end} Date objects bracketing the "next paycheck" window
    const today = new Date(); today.setHours(0,0,0,0);
    const payFreq = document.getElementById('payFrequency').value;
    const days = { weekly:7, biweekly:14, semimonthly:15, monthly:30 }[payFreq] || 14;
    const end = new Date(today); end.setDate(today.getDate() + days);
    return { start: today, end };
  }

  function isInNextPaycheck(dateStr) {
    if (!dateStr) return false;
    const d = new Date(dateStr + 'T00:00:00');
    const { start, end } = nextPaycheckDateRange();
    return d >= start && d <= end;
  }

  function purgeExpiredOneoffs() {
    const today = new Date(); today.setHours(0,0,0,0);
    const before = oneoffs.length;
    oneoffs = oneoffs.filter(o => {
      if (!o.date) return true;
      const d = new Date(o.date + 'T00:00:00');
      return d >= today;
    });
    if (oneoffs.length !== before) renderOneoffs();
  }

  function addOneOff(payee='', date='', amount='') {
    // Default date = tomorrow
    if (!date) {
      const d = new Date(); d.setDate(d.getDate()+1);
      date = d.toISOString().split('T')[0];
    }
    const id = oneoffId++;
    oneoffs.push({ id, payee, date, amount });
    renderOneoffs();
    calculate();
  }

  function removeOneOff(id) {
    oneoffs = oneoffs.filter(o => o.id !== id);
    renderOneoffs();
    calculate();
  }

  function updateOneOff(id, field, value) {
    const o = oneoffs.find(o => o.id === id);
    if (o) { o[field] = value; renderOneoffBadges(); calculate(); }
  }

  function renderOneoffBadges() {
    // Update "Next Paycheck" badges without full re-render
    oneoffs.forEach(o => {
      const badge = document.querySelector(`[data-oneoffbadge="${o.id}"]`);
      const pcLabel = document.querySelector(`[data-oneoffpc="${o.id}"]`);
      if (badge) badge.style.display = isInNextPaycheck(o.date) ? 'inline-block' : 'none';
      if (pcLabel) pcLabel.textContent = isInNextPaycheck(o.date) ? 'Next paycheck' : 'Future';
    });
  }

  function renderOneoffs() {
    const list = document.getElementById('oneoffList');
    const hdr  = document.getElementById('oneoffColHeaders');
    list.innerHTML = '';
    hdr.style.display = oneoffs.length > 0 ? 'block' : 'none';

    oneoffs.forEach(o => {
      const inNext = isInNextPaycheck(o.date);
      const row = document.createElement('div');
      row.className = 'oneoff-row';
      row.innerHTML = `
        <input type="text" placeholder="e.g. Student Loan Extra, Car Repair" value="${esc(o.payee)}"
          oninput="updateOneOff(${o.id},'payee',this.value)">
        <input type="date" value="${o.date}"
          onchange="updateOneOff(${o.id},'date',this.value)">
        <input type="number" placeholder="0.00" value="${o.amount}" min="0" step="0.01"
          oninput="updateOneOff(${o.id},'amount',this.value)">
        <div style="display:flex;align-items:center;height:39px;padding:0 4px;font-size:11px;color:#999;" data-oneoffpc="${o.id}">
          ${inNext ? 'Next paycheck' : 'Future'}
          <span class="oneoff-next-badge" data-oneoffbadge="${o.id}" style="display:${inNext?'inline-block':'none'}">next</span>
        </div>
        <button class="delete-btn" onclick="removeOneOff(${o.id})">×</button>
      `;
      list.appendChild(row);
    });
  }

  function calculate() {
    purgeExpiredOneoffs();
    const paycheck   = parseFloat(document.getElementById('paycheck').value) || 0;
    const extraInc   = parseFloat(document.getElementById('extraIncome').value) || 0;
    const payFreq    = document.getElementById('payFrequency').value;
    const savingsBal = parseFloat(document.getElementById('savingsBalance').value) || 0;
    const savingsAPY = parseFloat(document.getElementById('savingsAPY').value) || 0;
    const totalIncome = paycheck + extraInc;
    const paychecksPerYear = PAY_PER_YEAR[payFreq];

    // ── Bills per paycheck (from vendors) ──
    let billsPerPaycheck = 0;
    const catBreakdown = [];
    categories.forEach(c => {
      const vendors = [];
      let catTotal = 0;
      c.vendors.forEach(v => {
        const amt = parseFloat(v.amount) || 0;
        if (amt <= 0) return;
        const pp = billToPerPaycheck(amt, v.freq, payFreq);
        catTotal += pp; billsPerPaycheck += pp;
        vendors.push({ vendor: v.vendor||'Unnamed', description: v.description, amount: pp });
      });
      const el = document.querySelector(`[data-cattotal="${c.id}"]`);
      if (el) el.textContent = catTotal > 0 ? fmt(catTotal)+'/pp' : '';
      if (vendors.length > 0)
        catBreakdown.push({ name: c.name||'Unnamed', color: c.color, total: catTotal, vendors });
    });

    // ── One-offs this paycheck ──
    let oneoffTotal = 0;
    const oneoffItems = [];
    oneoffs.forEach(o => {
      const amt = parseFloat(o.amount) || 0;
      if (amt <= 0 || !isInNextPaycheck(o.date)) return;
      oneoffTotal += amt;
      oneoffItems.push({ payee: o.payee||'One-Off', date: o.date, amount: amt });
    });

    // ── Transfer = bills + one-offs (debt handled separately in snowball tab) ──
    const transferNeeded = billsPerPaycheck + oneoffTotal;
    const leftInChecking = totalIncome - transferNeeded;

    // ── Savings interest on current balance ──
    const monthlyInterest = savingsBal > 0 && savingsAPY > 0
      ? savingsBal * (Math.pow(1 + savingsAPY / 100, 1/12) - 1)
      : 0;
    const yearlyInterest = monthlyInterest * 12;

    // ── Update summary cards ──
    document.getElementById('totalIncome').textContent   = fmt(totalIncome);
    document.getElementById('savingsAmount').textContent = fmt(transferNeeded);
    document.getElementById('spendingLeft').textContent  = fmt(leftInChecking);

    const spendCard = document.getElementById('spendingCard');
    spendCard.className = 'result-card' + (leftInChecking < 0 ? ' warn' : leftInChecking > 0 ? ' highlight' : '');
    const transCard = document.getElementById('transferCard');
    transCard.className = 'result-card highlight' + (transferNeeded > totalIncome ? ' warn' : '');

    // ── Breakdown section ──
    const bSec  = document.getElementById('breakdownSection');
    const bRows = document.getElementById('breakdownRows');
    const hasContent = catBreakdown.length > 0 || oneoffItems.length > 0;

    if (hasContent) {
      bSec.style.display = 'block';
      bRows.innerHTML = catBreakdown.map(cat => `
        <div class="bcat-block">
          <div class="bcat-header">
            <div class="bcat-dot" style="background:${cat.color};"></div>
            <span class="bcat-name">${esc(cat.name)}</span>
            <span class="bcat-subtotal">${fmt(cat.total)}</span>
          </div>
          ${cat.vendors.map(v => `
            <div class="bvendor-row">
              <span class="bvendor-name">${esc(v.vendor)}</span>
              <span class="bvendor-desc">${esc(v.description)}</span>
              <span class="bvendor-amt">${fmt(v.amount)}</span>
            </div>`).join('')}
        </div>`).join('');

      const ocBlock = document.getElementById('oneoffResultCard');
      const ocRows  = document.getElementById('oneoffResultRows');
      const ocTotal = document.getElementById('oneoffTotal');
      if (oneoffItems.length > 0) {
        ocBlock.style.display = 'block';
        ocTotal.textContent = fmt(oneoffTotal);
        ocRows.innerHTML = oneoffItems.map(o => {
          const d = new Date(o.date+'T00:00:00');
          const lbl = d.toLocaleDateString('en-US',{month:'short',day:'numeric'});
          return `<div class="bvendor-row">
            <span class="bvendor-name">${esc(o.payee)}</span>
            <span class="bvendor-desc">due ${lbl}</span>
            <span class="bvendor-amt">${fmt(o.amount)}</span>
          </div>`;
        }).join('');
      } else {
        ocBlock.style.display = 'none';
      }

      document.getElementById('breakdownTotal').textContent = fmt(transferNeeded);
    } else {
      bSec.style.display = 'none';
    }

    // ── Savings account panel ──
    const monthlyBills = billsPerPaycheck * (paychecksPerYear / 12);
    document.getElementById('monthlyBillsAmt').textContent = fmt(monthlyBills) + '/mo';

    const coverLabel = document.getElementById('transferCoversLabel');
    if (totalIncome > 0) {
      const monthlyTransfer = transferNeeded * (paychecksPerYear / 12);
      const covers = monthlyTransfer >= monthlyBills;
      coverLabel.textContent = covers ? '✓ Yes' : '✗ Short by ' + fmt(monthlyBills - monthlyTransfer);
      coverLabel.style.color = covers ? '#74c69d' : '#ff8a75';
    } else {
      coverLabel.textContent = '—';
      coverLabel.style.color = 'rgba(255,255,255,0.3)';
    }

    const interestBlock = document.getElementById('savingsInterestBlock');
    if (monthlyInterest > 0) {
      interestBlock.style.display = 'block';
      document.getElementById('monthlyInterestAmt').textContent = fmt(monthlyInterest);
      document.getElementById('yearlyInterestAmt').textContent  = fmt(yearlyInterest) + '/yr';
    } else {
      interestBlock.style.display = 'none';
    }

    // ── Savings Goals (reactive update with live transfer amount) ──
    renderGoals(transferNeeded);
  }

  // ══════════════════════════════════════════════
  //  SAVINGS GOALS ENGINE
  // ══════════════════════════════════════════════
  let goals   = [];
  let goalId  = 0;

  function addGoal() {
    const id       = goalId++;
    const priority = goals.length + 1;
    goals.push({ id, name: '', target: '', current: '', priority });
    renderGoals();
    saveState();
    setTimeout(() => {
      const el = document.querySelector(`[data-goalname="${id}"]`);
      if (el) el.focus();
    }, 50);
  }

  function removeGoal(id) {
    goals = goals.filter(g => g.id !== id);
    // Re-number priorities sequentially
    goals.sort((a,b) => a.priority - b.priority)
         .forEach((g, i) => g.priority = i + 1);
    renderGoals();
    saveState();
  }

  function updateGoal(id, field, value) {
    const g = goals.find(g => g.id === id);
    if (!g) return;
    g[field] = value;
    renderGoals();
    saveState();
  }

  function moveGoalPriority(id) {
    // Cycle this goal to priority 1, shift others down
    const g = goals.find(g => g.id === id);
    if (!g) return;
    const sorted = [...goals].sort((a,b) => a.priority - b.priority);
    const idx    = sorted.findIndex(g2 => g2.id === id);
    // Rotate: clicking bumps priority up by 1, wraps around
    const newPri = g.priority === 1 ? goals.length : g.priority - 1;
    // Swap with whatever currently has that priority
    const swap = goals.find(g2 => g2.priority === newPri);
    if (swap) swap.priority = g.priority;
    g.priority = newPri;
    renderGoals();
    saveState();
  }

  function renderGoals(transferPerPaycheck) {
    // transferPerPaycheck is optional — if not passed, try to read it from the DOM
    const list = document.getElementById('goalList');
    if (!list) return;

    // Get the current transfer amount from the results panel
    const transferEl = document.getElementById('savingsAmount');
    const transfer   = transferPerPaycheck !== undefined
      ? transferPerPaycheck
      : (transferEl ? (parseFloat(transferEl.textContent.replace(/[^0-9.-]/g,'')) || 0) : 0);

    if (!goals.length) {
      list.innerHTML = '<div class="goals-empty">No goals yet — add one above to start tracking.</div>';
      return;
    }

    // Sort by priority for display and waterfall math
    const sorted = [...goals].sort((a,b) => a.priority - b.priority);

    // Waterfall: highest priority goal gets filled first each paycheck
    let remaining = transfer;

    list.innerHTML = '';
    sorted.forEach((g, rankIdx) => {
      const target  = parseFloat(g.target)  || 0;
      const current = parseFloat(g.current) || 0;
      const need    = Math.max(0, target - current);
      const pct     = target > 0 ? Math.min(100, Math.round((current / target) * 100)) : 0;
      const isComplete = target > 0 && current >= target;

      // How much of this paycheck's transfer goes to this goal
      const allotted    = Math.min(remaining, need);
      remaining         = Math.max(0, remaining - allotted);

      // Paychecks to completion for this goal
      let paychecksLabel = '—';
      if (isComplete) {
        paychecksLabel = '🎉 Funded!';
      } else if (need > 0 && allotted > 0) {
        const pp = Math.ceil(need / allotted);
        paychecksLabel = pp === 1 ? '1 paycheck' : pp + ' paychecks';
      } else if (need > 0 && allotted === 0) {
        paychecksLabel = 'after higher goals';
      }

      const card = document.createElement('div');
      card.className = 'goal-card' + (isComplete ? ' goal-complete' : '');
      card.setAttribute('data-goalcard', g.id);
      card.innerHTML = `
        <div class="goal-card-top">
          <div class="goal-priority-badge ${g.priority === 1 ? 'priority-1' : ''}"
            title="Priority ${g.priority} — click to bump up"
            onclick="moveGoalPriority(${g.id})">${g.priority}</div>
          <input class="goal-name-input" type="text" data-goalname="${g.id}"
            placeholder="Goal name (e.g. Emergency Fund, Japan Trip)"
            value="${esc(g.name)}" oninput="updateGoal(${g.id},'name',this.value)">
          <div class="goal-actions">
            ${isComplete ? '<span class="goal-complete-badge">✓ Goal Reached</span>' : ''}
            <button class="goal-delete-btn" onclick="removeGoal(${g.id})">×</button>
          </div>
        </div>
        <div class="goal-fields">
          <div class="goal-field">
            <label>Target Amount ($)</label>
            <input type="number" placeholder="0.00" value="${g.target}" min="0" step="0.01"
              oninput="updateGoal(${g.id},'target',this.value)">
          </div>
          <div class="goal-field">
            <label>Current Balance ($)</label>
            <input type="number" placeholder="0.00" value="${g.current}" min="0" step="0.01"
              oninput="updateGoal(${g.id},'current',this.value)">
          </div>
          <div class="goal-field">
            <label>Est. Completion</label>
            <input type="text" value="${paychecksLabel}" readonly>
          </div>
        </div>
        <div class="goal-progress-wrap">
          <div class="goal-progress-meta">
            <span class="goal-pct">${pct}% funded</span>
            <span>${isComplete ? 'Complete!' : (target > 0 ? fmt(need) + ' remaining' : 'set a target')}</span>
          </div>
          <div class="goal-progress-track">
            <div class="goal-progress-fill" style="width:${pct}%"></div>
          </div>
        </div>`;
      list.appendChild(card);
    });
  }

  // ══════════════════════════════════════════════
  //  DEBT SNOWBALL ENGINE  (fully self-contained)
  // ══════════════════════════════════════════════
  let sbDebts   = [];
  let sbDebtId  = 0;
  let sbRoadmapVisible = false;

  const sbFmt = n => '$' + Math.abs(n).toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2});
  const sbEl  = id => document.getElementById(id);

  function sbAddDebt() {
    const name   = sbEl('sb-newName').value.trim();
    const bal    = parseFloat(sbEl('sb-newBal').value)  || 0;
    const min    = parseFloat(sbEl('sb-newMin').value)  || 0;
    const apr    = parseFloat(sbEl('sb-newAPR').value)  || 0;
    if (bal <= 0) { sbEl('sb-newBal').focus(); return; }
    const id = sbDebtId++;
    sbDebts.push({ id, name: name || 'Debt ' + (id+1), balance: bal, minPmt: min, apr, originalBalance: bal });
    sbEl('sb-newName').value = '';
    sbEl('sb-newBal').value  = '';
    sbEl('sb-newMin').value  = '';
    sbEl('sb-newAPR').value  = '';
    sbEl('sb-newName').focus();
    sbRender();
    sbSave();
  }

  function sbRemoveDebt(id) {
    sbDebts = sbDebts.filter(d => d.id !== id);
    sbRender();
    sbSave();
  }

  function sbUpdateDebt(id, field, value) {
    const d = sbDebts.find(d => d.id === id);
    if (!d) return;
    const num = parseFloat(value) || 0;
    d[field] = field === 'name' ? value : num;
    if (field === 'balance' && num > (d.originalBalance || 0)) d.originalBalance = num;
    sbPatchCalc();
    // Debounced save — separate timer so keystrokes don't cancel each other
    clearTimeout(sbUpdateDebt._t);
    sbUpdateDebt._t = setTimeout(sbSave, 600);
  }

  // Lightweight recalc: only patch computed/readonly values, never touch input elements
  function sbPatchCalc() {
    const extra  = parseFloat(sbEl('sb-extra').value) || 0;
    const result = sbSimulate(sbDebts, extra);
    const resultNoExtra = extra > 0 ? sbSimulate(sbDebts, 0) : null;

    const totalDebt = sbDebts.reduce((s,d) => s + d.balance, 0);
    const origTotal = sbDebts.reduce((s,d) => s + (d.originalBalance||d.balance), 0);
    const paidPct   = origTotal > 0 ? Math.min(100, Math.round((1 - totalDebt/origTotal)*100)) : 0;

    sbEl('sb-totalDebt').textContent = sbFmt(totalDebt);
    sbEl('sb-totalDebtSub').textContent = sbDebts.length + ' debt' + (sbDebts.length!==1?'s':'');
    sbEl('sb-overallBar').style.width = paidPct + '%';
    sbEl('sb-overallPct').textContent = paidPct + '% paid off';

    const now = new Date();
    if (result) {
      const payoffDate = result.months
        ? new Date(now.getFullYear(), now.getMonth() + result.months, 1)
            .toLocaleDateString('en-US',{month:'long',year:'numeric'})
        : '>50 years';
      sbEl('sb-months').textContent       = result.months ?? '>600';
      sbEl('sb-debtFreeDate').textContent = 'debt free ' + payoffDate;
      sbEl('sb-interest').textContent     = sbFmt(result.totalInterest);

      const noExtraResult = resultNoExtra || result;
      sbEl('sb-noExtraDate').textContent = noExtraResult.months
        ? new Date(now.getFullYear(), now.getMonth() + noExtraResult.months, 1)
            .toLocaleDateString('en-US',{month:'short',year:'numeric'}) : '>50 yrs';
      sbEl('sb-withExtraDate').textContent = extra > 0 && result.months
        ? new Date(now.getFullYear(), now.getMonth() + result.months, 1)
            .toLocaleDateString('en-US',{month:'short',year:'numeric'})
        : (extra > 0 ? '>50 yrs' : 'add extra above');
      sbEl('sb-interestSaved').textContent = resultNoExtra
        ? sbFmt(resultNoExtra.totalInterest - result.totalInterest) : '—';
    } else {
      sbEl('sb-months').textContent       = '—';
      sbEl('sb-debtFreeDate').textContent = 'enter balances & payments';
      sbEl('sb-interest').textContent     = '$0';
      sbEl('sb-noExtraDate').textContent  = '—';
      sbEl('sb-withExtraDate').textContent= extra > 0 ? '—' : 'add extra above';
      sbEl('sb-interestSaved').textContent= '—';
    }

    // Patch each card's computed-only elements (progress bar, payoff label, this-month-pay)
    const sorted = [...sbDebts].filter(d=>d.balance>0).sort((a,b)=>a.balance-b.balance);
    const targetId = sorted[0]?.id;
    const paidOffMap = {};
    if (result) result.debtOrder.forEach(d => { if (d.paidOffMonth) paidOffMap[d.id] = d.paidOffMonth; });

    sbDebts.forEach(d => {
      const card = document.querySelector(`[data-sbcard="${d.id}"]`);
      if (!card) return;
      const isPaidOff = d.balance <= 0;
      const isTarget  = !isPaidOff && d.id === targetId;
      const origBal   = d.originalBalance || d.balance;
      const pct       = origBal > 0 ? Math.min(100, Math.round((1 - d.balance/origBal)*100)) : 100;
      const paidMonth = paidOffMap[d.id];

      let payoffLabel = '—';
      if (isPaidOff) payoffLabel = '🎉 Paid Off!';
      else if (paidMonth) payoffLabel = new Date(now.getFullYear(), now.getMonth()+paidMonth, 1)
        .toLocaleDateString('en-US',{month:'short',year:'numeric'});
      else if (d.minPmt <= 0) payoffLabel = 'add min. payment';

      // Update card class
      card.className = 'sb-debt-card' + (isTarget?' sb-target':'') + (isPaidOff?' sb-done':'');

      // Patch progress bar
      const fill = card.querySelector('.sb-prog-fill-sm');
      if (fill) fill.style.width = pct + '%';
      const meta = card.querySelectorAll('.sb-prog-meta span');
      if (meta[0]) meta[0].textContent = pct + '% paid' + (isTarget ? ' · target' : '');
      if (meta[1]) meta[1].textContent = isPaidOff ? 'Paid off!' : sbFmt(d.balance) + ' left · est. ' + payoffLabel;

      // Patch readonly "This Month Pay"
      const readonlyInputs = card.querySelectorAll('input[readonly]');
      if (readonlyInputs[0]) readonlyInputs[0].value = isPaidOff ? '—' : sbFmt(isTarget ? d.minPmt + extra : d.minPmt);

      // Patch target/done badges
      const targetBadge = card.querySelector('.sb-badge-target');
      const doneBadge   = card.querySelector('.sb-badge-done');
      if (targetBadge) targetBadge.style.display = isTarget  ? '' : 'none';
      if (doneBadge)   doneBadge.style.display   = isPaidOff ? '' : 'none';
    });

    if (result) sbBuildRoadmap(result);
  }

  // Core simulation: returns per-debt schedule + totals
  function sbSimulate(debtList, extra) {
    if (!debtList.length) return null;

    const debts = debtList
      .filter(d => d.balance > 0 && d.minPmt > 0)
      .map(d => ({
        id: d.id, name: d.name,
        balance: d.balance,
        minPmt: d.minPmt,
        monthlyRate: (d.apr / 100) / 12,
        originalBalance: d.originalBalance || d.balance,
        paidOffMonth: null,
      }))
      .sort((a, b) => a.balance - b.balance);

    if (!debts.length) return null;

    const working     = debts.map(d => ({ ...d }));
    const MAX         = 600;
    let month         = 0;
    let totalInterest = 0;
    let rolledExtra   = 0; // freed minimums accumulate here permanently
    const monthlyRows = [];

    while (working.some(d => d.balance > 0.005) && month < MAX) {
      month++;
      const row = { month };

      // Total snowball this month = base extra + all freed minimums so far
      let snowball = extra + rolledExtra;

      // Find current target (smallest remaining balance)
      const targetIdx = working.findIndex(d => d.balance > 0.005);

      working.forEach((d, i) => {
        if (d.balance <= 0.005) { row[d.id] = { pmt: 0, bal: 0, interest: 0 }; return; }

        const interest = d.balance * d.monthlyRate;
        totalInterest += interest;
        d.balance += interest;

        let pmt = d.minPmt;
        if (i === targetIdx) pmt += snowball;
        pmt = Math.min(pmt, d.balance);
        d.balance -= pmt;
        row[d.id] = { pmt, bal: Math.max(0, d.balance), interest };

        if (d.balance <= 0.005) {
          d.balance = 0;
          if (!d.paidOffMonth) {
            d.paidOffMonth = month;
            // Roll this minimum into the permanent extra for ALL future months
            rolledExtra += d.minPmt;
          }
        }
      });

      monthlyRows.push(row);
    }

    return {
      months: month >= MAX ? null : month,
      totalInterest,
      monthlyRows,
      debtOrder: debts,
      working,
    };
  }

  function sbRenderCards(result) {
    const extra      = parseFloat(sbEl('sb-extra').value) || 0;
    const list       = sbEl('sb-debtList');

    if (!sbDebts.length) {
      list.innerHTML = '<div class="sb-empty">No debts added yet. Use the form above to get started.</div>';
      return;
    }

    // Determine target (smallest balance with balance > 0)
    const sorted = [...sbDebts].filter(d=>d.balance>0).sort((a,b)=>a.balance-b.balance);
    const targetId = sorted[0]?.id;

    // Build paidOffMonth map from result
    const paidOffMap = {};
    if (result) result.debtOrder.forEach(d => { if (d.paidOffMonth) paidOffMap[d.id] = d.paidOffMonth; });

    // Sort display: active by balance asc, paid off last
    const displayOrder = [
      ...sbDebts.filter(d=>d.balance>0).sort((a,b)=>a.balance-b.balance),
      ...sbDebts.filter(d=>d.balance<=0),
    ];

    list.innerHTML = '';
    displayOrder.forEach((d, rankIdx) => {
      const isPaidOff = d.balance <= 0;
      const isTarget  = !isPaidOff && d.id === targetId;
      const origBal   = d.originalBalance || d.balance;
      const pct       = origBal > 0 ? Math.min(100, Math.round((1 - d.balance/origBal)*100)) : 100;
      const paidMonth = paidOffMap[d.id];
      let payoffLabel = '—';
      if (isPaidOff) payoffLabel = '🎉 Paid Off!';
      else if (paidMonth) {
        const now = new Date();
        payoffLabel = new Date(now.getFullYear(), now.getMonth()+paidMonth, 1)
          .toLocaleDateString('en-US',{month:'short',year:'numeric'});
      } else if (d.minPmt <= 0) payoffLabel = 'add min. payment';

      const thisMonthPmt = isTarget
        ? (d.minPmt + extra)
        : d.minPmt;

      const card = document.createElement('div');
      card.className = 'sb-debt-card' + (isTarget?' sb-target':'') + (isPaidOff?' sb-done':'');
      card.setAttribute('data-sbcard', d.id);
      card.innerHTML = `
        <div class="sb-debt-head">
          <span class="sb-debt-num">${isPaidOff ? '✓' : rankIdx+1}</span>
          <input class="sb-debt-name" type="text" placeholder="Debt name"
            value="${d.name.replace(/"/g,'&quot;')}"
            oninput="sbUpdateDebt(${d.id},'name',this.value)">
          ${isTarget  ? '<span class="sb-badge-target">🎯 Target</span>' : ''}
          ${isPaidOff ? '<span class="sb-badge-done">Paid Off</span>'    : ''}
          <button class="sb-del-btn" onclick="sbRemoveDebt(${d.id})">×</button>
        </div>
        <div class="sb-debt-fields">
          <div class="sb-debt-field">
            <label>Balance ($)</label>
            <input type="number" placeholder="0.00" value="${d.balance||''}" min="0" step="0.01"
              oninput="sbUpdateDebt(${d.id},'balance',this.value)">
          </div>
          <div class="sb-debt-field">
            <label>Min. Payment ($)</label>
            <input type="number" placeholder="0.00" value="${d.minPmt||''}" min="0" step="0.01"
              oninput="sbUpdateDebt(${d.id},'minPmt',this.value)">
          </div>
          <div class="sb-debt-field">
            <label>APR (%)</label>
            <input type="number" placeholder="0.00" value="${d.apr||''}" min="0" step="0.01"
              oninput="sbUpdateDebt(${d.id},'apr',this.value)">
          </div>
          <div class="sb-debt-field">
            <label>This Month Pay</label>
            <input type="text" value="${isPaidOff ? '—' : sbFmt(thisMonthPmt)}" readonly>
          </div>
        </div>
        <div class="sb-prog-wrap">
          <div class="sb-prog-meta">
            <span>${pct}% paid${isTarget ? ' · target' : ''}</span>
            <span>${isPaidOff ? 'Paid off!' : sbFmt(d.balance) + ' left · est. ' + payoffLabel}</span>
          </div>
          <div class="sb-prog-track-sm">
            <div class="sb-prog-fill-sm" style="width:${pct}%"></div>
          </div>
        </div>`;
      list.appendChild(card);
    });
  }

  function sbBuildRoadmap(result) {
    const roadmap = sbEl('sb-roadmap');
    if (!result || !result.monthlyRows.length) { roadmap.style.display='none'; return; }
    roadmap.style.display = 'block';
    if (!sbRoadmapVisible) return; // don't build table until shown

    const debtOrder = result.debtOrder;
    const thead = sbEl('sb-thead');
    const tbody  = sbEl('sb-tbody');

    // Header
    thead.innerHTML = '<tr><th>Month</th><th>Date</th>' +
      debtOrder.map(d=>`<th>${d.name}</th>`).join('') +
      '<th>Total Paid</th><th>Interest</th></tr>';

    // Rows
    const now = new Date();
    tbody.innerHTML = result.monthlyRows.map((row, i) => {
      const date = new Date(now.getFullYear(), now.getMonth() + i + 1, 1)
        .toLocaleDateString('en-US',{month:'short',year:'numeric'});
      let totalPaid = 0, totalInterest = 0;
      const cells = debtOrder.map(d => {
        const cell = row[d.id];
        if (!cell || cell.pmt === 0) return `<td class="sb-zero">—</td>`;
        totalPaid    += cell.pmt;
        totalInterest += cell.interest;
        const isPayoff = cell.bal <= 0.005;
        return `<td class="${isPayoff?'sb-target-cell':''}">${sbFmt(cell.pmt)}${isPayoff?' ✓':''}</td>`;
      }).join('');
      const isAllDone = debtOrder.every(d => !row[d.id] || row[d.id].bal <= 0.005);
      return `<tr class="${isAllDone?'sb-payoff-row':''}">
        <td>${i+1}</td><td>${date}</td>${cells}
        <td>${sbFmt(totalPaid)}</td><td style="color:#d4a843;">${sbFmt(totalInterest)}</td>
      </tr>`;
    }).join('');
  }

  function sbToggleRoadmap() {
    sbRoadmapVisible = !sbRoadmapVisible;
    sbEl('sb-tableWrap').style.display = sbRoadmapVisible ? 'block' : 'none';
    sbEl('sb-toggleBtn').textContent   = sbRoadmapVisible ? 'Hide Table' : 'Show Table';
    if (sbRoadmapVisible) {
      const extra  = parseFloat(sbEl('sb-extra').value) || 0;
      const result = sbSimulate(sbDebts, extra);
      if (result) sbBuildRoadmap(result);
    }
  }

  function sbCalculate() { sbPatchCalc(); }
  function sbRender()    { sbRenderCards(sbSimulate(sbDebts, parseFloat(sbEl('sb-extra')?.value)||0)); sbPatchCalc(); }

  // ── Snowball persistence ──
  function sbSave() {
    clearTimeout(_saveTimer);
    _saveTimer = setTimeout(() => {
      try {
        const activeTab = document.querySelector('.tab-panel.active')?.id?.replace('tab-','') || 'budget';
        const state = {
          activeTab,
          paycheck:       document.getElementById('paycheck').value,
          payFrequency:   document.getElementById('payFrequency').value,
          extraIncome:    document.getElementById('extraIncome').value,
          savingsBalance: document.getElementById('savingsBalance').value,
          savingsAPY:     document.getElementById('savingsAPY').value,
          sbExtra:        sbEl('sb-extra').value,
          categories, catId, vendorId,
          oneoffs, oneoffId,
          sbDebts, sbDebtId,
          goals, goalId,
        };
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch(e) { console.warn('Save failed:', e); }
    }, 300);
  }

  // ── Persistence ──
  const STORAGE_KEY = 'paycheck_planner_v3';
  let _saveTimer = null;

  // ── Tab switching ──
  function switchTab(tab) {
    document.querySelectorAll('.tab-panel').forEach(p => {
      p.classList.remove('active');
      p.style.display = 'none';
    });
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    const panel = document.getElementById('tab-' + tab);
    panel.classList.add('active');
    panel.style.display = 'block';
    document.querySelector(`.tab-btn[onclick="switchTab('${tab}')"]`).classList.add('active');
    sbSave();
  }

  function saveState() { sbSave(); } // alias

  function loadState() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return false;
      const s = JSON.parse(raw);

      document.getElementById('paycheck').value       = s.paycheck      || '';
      document.getElementById('payFrequency').value   = s.payFrequency  || 'biweekly';
      document.getElementById('extraIncome').value    = s.extraIncome   || '';
      document.getElementById('savingsBalance').value = s.savingsBalance || '';
      document.getElementById('savingsAPY').value     = s.savingsAPY    || '';
      if (sbEl('sb-extra')) sbEl('sb-extra').value    = s.sbExtra        || '';

      categories = s.categories || [];
      catId      = s.catId      || 0;
      vendorId   = s.vendorId   || 0;
      oneoffs    = s.oneoffs    || [];
      oneoffId   = s.oneoffId   || 0;
      sbDebts    = (s.sbDebts   || []).map(d => ({
        ...d,
        originalBalance: d.originalBalance || d.balance,
      }));
      sbDebtId   = s.sbDebtId   || 0;
      goals      = s.goals      || [];
      goalId     = s.goalId     || 0;

      if (s.activeTab && s.activeTab !== 'budget') switchTab(s.activeTab);

      return true;
    } catch(e) {
      console.warn('Load failed:', e);
      return false;
    }
  }

  const _origAddCat      = addCategory;
  const _origRemoveCat   = removeCategory;
  const _origUpdateCat   = updateCatName;
  const _origToggleCat   = toggleCat;
  const _origAddVendor   = addVendor;
  const _origRemoveVendor= removeVendor;
  const _origUpdateVendor= updateVendor;
  const _origAddOneOff   = addOneOff;
  const _origRemoveOneOff= removeOneOff;
  const _origUpdateOneOff= updateOneOff;

  addCategory    = (...a) => { _origAddCat(...a);       saveState(); };
  removeCategory = (...a) => { _origRemoveCat(...a);    saveState(); };
  updateCatName  = (...a) => { _origUpdateCat(...a);    saveState(); };
  toggleCat      = (...a) => { _origToggleCat(...a);    saveState(); };
  addVendor      = (...a) => { _origAddVendor(...a);    saveState(); };
  removeVendor   = (...a) => { _origRemoveVendor(...a); saveState(); };
  updateVendor   = (...a) => { _origUpdateVendor(...a); saveState(); };
  addOneOff      = (...a) => { _origAddOneOff(...a);    saveState(); };
  removeOneOff   = (...a) => { _origRemoveOneOff(...a); saveState(); };
  updateOneOff   = (...a) => { _origUpdateOneOff(...a); saveState(); };

  ['paycheck','payFrequency','extraIncome','savingsBalance','savingsAPY'].forEach(id => {
    const el = document.getElementById(id);
    if (!el) return;
    el.addEventListener('input',  saveState);
    el.addEventListener('change', saveState);
  });

  // ── Boot: load saved state or fall back to seed data ──
  const didLoad = loadState();

  if (didLoad) {
    renderCategories();
    renderOneoffs();
    renderGoals();
    sbRender();
    calculate();
  } else {
    // First-time seed data
    _origAddCat('Housing');
    _origAddVendor(0, 'Landlord / Bank',    'rent or mortgage', '', 'monthly');
    _origAddVendor(0, 'Electric / Gas Co.', 'utilities',        '', 'monthly');
    _origAddVendor(0, 'Water Dept.',        '',                  '', 'monthly');

    _origAddCat('Transport');
    _origAddVendor(1, 'Auto Lender',    'car payment',    '', 'monthly');
    _origAddVendor(1, 'Insurance Co.',  'auto insurance', '', 'monthly');
    _origAddVendor(1, 'Gas Station',    'fuel estimate',  '', 'monthly');

    _origAddCat('Subscriptions');
    _origAddVendor(2, 'Internet Provider', '', '', 'monthly');
    _origAddVendor(2, 'Netflix',  'streaming', '', 'monthly');
    _origAddVendor(2, 'Spotify',  'music',     '', 'monthly');

    _origAddCat('Food & Groceries');
    _origAddVendor(3, 'Grocery Store', '',         '', 'monthly');
    _origAddVendor(3, 'Dining Out',    'estimate', '', 'monthly');

    _origAddCat('Health');
    _origAddVendor(4, 'Health Insurance', '', '', 'monthly');
    _origAddVendor(4, 'Gym / Fitness',    '', '', 'monthly');

    renderCategories();
    renderOneoffs();
    renderGoals();
    sbRender();
    calculate();
    saveState();
  }
</script>

<footer style="
  background:#0d0d1a;
  border-top:1px solid rgba(255,255,255,0.06);
  padding:28px 40px;
  text-align:center;
  font-family:'DM Mono',monospace;
">
