    </div>

    <!-- Monthly Roadmap -->
    <div class="sb-roadmap" id="sb-roadmap" style="display:none;">
      <div class="sb-roadmap-title">
        Monthly Roadmap
        <button class="sb-roadmap-toggle" id="sb-toggleBtn" onclick="sbToggleRoadmap()">Show Table</button>
      </div>
