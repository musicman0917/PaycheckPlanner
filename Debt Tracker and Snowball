        <div class="sb-card-lbl">Total Debt Remaining</div>
        <div class="sb-card-val" id="sb-totalDebt">$0</div>
        <div class="sb-card-sub" id="sb-totalDebtSub">add your debts below</div>
      </div>
      <div class="sb-card card-months">
        <div class="sb-card-lbl">Months to Freedom</div>
